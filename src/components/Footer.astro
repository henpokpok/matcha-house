---
const lineOaLink = "https://line.me/R/ti/p/@zenithmatcha";
---
<footer class="bg-surface-container-low w-full py-section-gap mt-section-gap">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 md:grid-cols-3 gap-gutter">
    <!-- Brand Column -->
    <div class="flex flex-col gap-4">
      <span class="font-display-lg text-headline-sm text-primary">ZENITH MATCHA</span>
      <p class="font-body-md text-body-md text-secondary mt-2">
        © 2026 Zenith Matcha. Wabi-sabi in every whisk.
      </p>
    </div>
    
    <!-- Contact Info Column -->
    <div class="flex flex-col gap-3 justify-center">
      <span class="font-label-md text-label-md text-primary uppercase tracking-wider">Connect With Us</span>
      <p class="font-body-md text-body-md text-on-surface-variant">
        Add us on LINE to place orders, consult with tea experts, or ask wholesale questions.
      </p>
      <a class="inline-flex items-center gap-2 font-label-md text-label-md text-primary font-bold hover:opacity-80 transition-opacity" href={lineOaLink} target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined text-[18px]">chat</span> @zenithmatcha
      </a>
    </div>
    
    <!-- Links Column -->
    <div class="flex flex-col gap-3 md:items-end justify-center">
      <a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="#">Privacy Policy</a>
      <a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="#">Shipping Details</a>
      <a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="#">Wholesale Inquiries</a>
      <a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors duration-200" href="#">Contact Us</a>
    </div>
  </div>
</footer>
