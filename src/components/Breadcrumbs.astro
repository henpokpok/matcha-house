---
interface Props {
  items: {
    label: string;
    href?: string;
  }[];
}

const { items } = Astro.props;
---
<nav class="font-body-md text-body-md text-on-surface-variant flex items-center gap-2">
  {items.map((item, idx) => (
    <>
      {item.href ? (
        <a class="hover:text-primary transition-colors" href={item.href}>{item.label}</a>
      ) : (
        <span class="text-primary font-medium">{item.label}</span>
      )}
      {idx < items.length - 1 && (
        <span class="material-symbols-outlined select-none text-[16px]" style="font-size: 16px;">chevron_right</span>
      )}
    </>
  ))}
</nav>
